# Supabase PostgreSQL
# Host: db.[YOUR-PROJECT-REF].supabase.co
# Port: 5432
# Database: postgres
# User: postgres
# Replace [YOUR-PASSWORD] with your Supabase database password.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
AGENT_MODEL=gpt-4.1-mini
SEED_DEMO_DATA=true
USE_REAL_MARKET_DATA=true
SCAN_ALL_B3=true
B3_UNIVERSE_LIMIT=0
B3_MIN_VOLUME=1
B3_RECENT_TRADING_DAYS=30
B3_REFRESH_BATCH_SIZE=40
INCLUDE_SMALLCAPS=true
B3_SMALLCAP_TICKERS=ALPA4,ANIM3,AZUL4,BEEF3,BMOB3,BRAP4,CAML3,CEAB3,COGN3,CVCB3,CYRE3,DIRR3,ECOR3,EVEN3,EZTC3,GFSA3,GUAR3,HBSA3,LAVV3,LWSA3,MDIA3,MELK3,MILS3,MOVI3,MRVE3,ODPV3,PETZ3,PNVL3,POMO4,POSI3,QUAL3,RAPT4,SEER3,SIMH3,SLCE3,SMTO3,TEND3,TUPY3,VLID3,YDUQ3
CREATE_DB_ON_STARTUP=true
AUTO_RUN_SCANNER=false
SCANNER_INTERVAL_SECONDS=180
SCANNER_INITIAL_DELAY_SECONDS=30
